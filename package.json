{
  "name": "@tumaet/ui-react",
  "version": "0.2.0",
  "description": "TUM AET UI for React: components from the Applied Education Technologies research group at TUM",
  "keywords": [
    "react",
    "components",
    "design-system",
    "tumaet"
  ],
  "author": "TUM Applied Education Technologies <https://aet.cit.tum.de/>",
  "license": "MIT",
  "homepage": "https://github.com/ls1intum/tum-aet-ui-react#readme",
  "bugs": {
    "url": "https://github.com/ls1intum/tum-aet-ui-react/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ls1intum/tum-aet-ui-react.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"require(\\\"node:fs\\\").rmSync(\\\"dist\\\",{recursive:true,force:true})\"",
    "build": "pnpm run clean && vite build && tsc -p tsconfig.build.json && node scripts/fix-type-extensions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "pnpm run build && vitest run --config vitest.browser.config.ts",
    "test:browser:install": "playwright install --with-deps chromium firefox webkit",
    "typecheck": "tsc && tsc -p tests/browser",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "pack:check": "pnpm run test:package && pnpm run build && node scripts/pack-check.mjs",
    "test:package": "node --test scripts/*.test.mjs",
    "test:consumer": "node scripts/consumer/run.mjs",
    "prepublishOnly": "node --eval \"throw new Error(\\\"Publish only the validated tarball in build/package (see RELEASING.md).\\\")\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "format:check": "prettier --check . --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "9.39.5",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "axe-core": "^4.14.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semver": "7.8.6",
    "storybook": "^10.6.5",
    "stylelint": "18.0.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~7.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  }
}
